 "injuries": [
  {
   "id": "643235",
   "name": "Tyjae Spears",
   "pos": "RB",
   "status": "Active",
   "date": "2026-10-19T03:10Z",
   "shortComment": "Spears rushed once for one yard while reeling in his only target for seven yards during Sunday's 26-20 win over Indianapolis.",
   "longComment": "Spears was dealing with a knee injury throughout the week before ultimately being active in Week 6. The running back registered a season-low two touches in the contest, and he has now compiled 13 rushing yards on eight carries over the last four games combined. Spears will continue to be an unappealing fantasy option as a long as starting running back Tony Pollard is available for Tennessee.",
   "details": null
  },
  {
   "id": "643224",
   "name": "Wan'Dale Robinson",
   "pos": "WR",
   "status": "Active",
   "date": "2026-10-19T02:16Z",
   "shortComment": "Robinson caught three of seven targets for 22 yards during Sunday's 26-20 win over the Colts.",
   "longComment": "Robinson finished tied for the team lead in targets with fellow wideout Carnell Tate, but he finished with 22 or fewer receiving yards for the second time in three weeks and the third time overall this season. The wide receiver, along with the rest of Tennessee's offense, is incredibly inconsistent, but he has seen at least five targets in four straight games.",
   "details": null
  },
  {
   "id": "643169",
   "name": "Carnell Tate",
   "pos": "WR",
   "status": "Active",
   "date": "2026-10-18T23:28Z",
   "shortComment": "Tate caught six of seven targets for 70 yards and a touchdown in Sunday's 26-20 win over the Colts.",
   "longComment": "The rookie wideout capped a solid performance with an eight-yard TD in the fourth quarter, accounting for the Titans' only points on offense for the afternoon in their first win of 2026 and marking the first touchdown of his career. Tate's numbers were more remarkable considering that Cam Ward threw for a meager 102 yards in the game. Tate has begun to find a groove, posting a 22-279-1 line on 33 targets over his last four games. He'll look to keep rolling in Week 7 against the Browns.",
   "details": null
  },
  {
   "id": "643168",
   "name": "Tony Pollard",
   "pos": "RB",
   "status": "Active",
   "date": "2026-10-18T23:24Z",
   "shortComment": "Pollard carried the ball 19 times for 76 yards and failed to catch his only target in Sunday's 26-20 win over the Colts.",
   "longComment": "Tyjae Spears had only two touches as Pollard dominated work in the Titans backfield, and the veteran RB led the team in scrimmage yards on the afternoon. Pollard's 76 rushing yards were a season high, but he's gotten into the end zone just once in six games. He'll offer a solid floor, but little ceiling, in a Week 7 matchup against the Browns.",
   "details": null
  },
  {
   "id": "643167",
   "name": "Cam Ward",
   "pos": "QB",
   "status": "Active",
   "date": "2026-10-18T23:17Z",
   "shortComment": "Ward completed 11 of 22 passes for 102 yards and one touchdown with one interception in Sunday's 26-20 win over the Colts. He added seven yards on three carries.",
   "longComment": "The second-year QB put together his least productive game of the season, but Ward did connect with Carnell Tate for an eight-yard score in the fourth quarter. The Titans' special teams units accounted for the rest of their points in the team's first win of the year on four Joey Slye field goals and a blocked punt return for a TD. Ward has failed to reach 200 passing yards in five of six games to begin the season with a 4:4 TD:INT, giving him little fantasy appeal heading into a Week 7 tilt against the Browns.",
   "details": null
  },

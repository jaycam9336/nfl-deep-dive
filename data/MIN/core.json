  {
   "id": "641034",
   "name": "Demond Claiborne",
   "pos": "RB",
   "status": "Active",
   "date": "2026-10-06T03:41Z",
   "shortComment": "Claiborne carried the ball three times for 12 yards during Minnesota's win over the Dolphins on Sunday.",
   "longComment": "Claiborne continued to serve a limited role behind Aaron Jones even with Jordan Mason (thumb) on injured reserve. Claiborne will look to be more involved offensively during next week's matchup versus the Saints.",
   "details": null
  },
  {
   "id": "639955",
   "name": "Joshua Metellus",
   "pos": "S",
   "status": "Active",
   "date": "2026-09-30T04:44Z",
   "shortComment": "Metellus recorded nine tackles (four solo), including 0.5 sacks, and a defensed pass Sunday against Tampa Bay in a 23-16 victory.",
   "longComment": "Metellus logged the second-most tackles on Minnesota behind Eric Wilson (11). One of his stops was an assisted sack of Baker Mayfield on the first play of the fourth quarter. Metellus has played every defensive snap for the Vikings so far this season and has racked up 20 tackles and two pass defenses through three contests.",
   "details": null
  },
  {
   "id": "639951",
   "name": "Isaiah Rodgers",
   "pos": "CB",
   "status": "Active",
   "date": "2026-09-30T04:28Z",
   "shortComment": "Rodgers logged six tackles (two solo) and an interception in Sunday's 23-16 victory over Tampa Bay.",
   "longComment": "Minnesota led by seven points late in the fourth quarter when Rodgers picked off rookie Jalon Daniels on a last-second heave that drifted just short of the end zone. It was Rodgers' first interception of the season and the fifth of his six-year career. The veteran cornerback emerged as a key starter for Minnesota last season and has played nearly every defensive snap for the team so far in 2026.",
   "details": null
  },
  {
   "id": "639949",
   "name": "Eric Wilson",
   "pos": "LB",
   "status": "Active",
   "date": "2026-09-30T04:04Z",
   "shortComment": "Wilson finished Sunday's 23-16 victory over Tampa Bay with 10 tackles, including 1.5 sacks, and one defensed pass.",
   "longComment": "Wilson not only led Minnesota with 10 stops, he was also responsible for 1.5 of the team's six total sacks. The veteran linebacker recorded a career-high 6.5 sacks across 17 regular-season games with the Vikings last year, as he's benefitted statistically from being in defensive coordinator Brian Flores' blitz-happy system. Wilson also surpassed 100 tackles for the second time in his career last year and is on pace to do so again in 2026 with 20 stops through three contests.",
   "details": null
  },
  {
   "id": "639872",
   "name": "Josh Oliver",
   "pos": "TE",
   "status": "Injured Reserve",
   "date": "2026-09-30T00:26Z",
   "shortComment": "The Vikings placed Oliver (biceps) on injured reserve Tuesday, Craig Peters of the team's official site reports.",
   "longComment": "Oliver's move to IR was expected after the tight end was diagnosed with a torn bicep Monday. The tight end will likely miss most, if not all, of the 2026 season as he recovers from surgery. T.J. Hockenson and Gavin Bartholomew are now the only tight ends on the Vikings' roster, meaning practice-squad elevations ahead of Week 4 will likely include at least one more option at the position. The Vikings signed linebacker Kyle Van Noy to the 53-man roster in a corresponding move.",
   "details": {
    "fantasyStatus": {
     "description": "IR",
     "abbreviation": "IR"
    },
    "type": "Biceps",
    "location": "Arm",
    "detail": "Surgery",
    "side": "Not Specified",
    "returnDate": "2027-01-17"
   }
  },
  {
   "id": "639870",
   "name": "Kyle Van Noy",
   "pos": "LB",
   "status": "Active",
   "date": "2026-09-30T00:20Z",
   "shortComment": "The Vikings signed Van Noy from the practice squad to the active roster Tuesday, Craig Peters of the team's official site reports.",
   "longComment": "The Vikings burned through Van Noy's practice-squad elevations by playing the veteran linebacker in each of the team's three wins to start the 2026 regular season. Van Noy logged 59 defensive snaps over the three contests, totaling seven tackles (five solo), including 1.5 sacks. The 35-year-old will now serve as a key rotational edge rusher for the team, this time on the 53-man roster.",
   "details": null
  }

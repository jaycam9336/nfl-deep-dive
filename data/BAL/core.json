  {
   "id": "642507",
   "name": "Trey Hendrickson",
   "pos": "LB",
   "status": "Active",
   "date": "2026-10-15T00:00Z",
   "shortComment": "Hendrickson (finger) was a full participant at practice Wednesday.",
   "longComment": "Hendrickson has been sidelined for the past two games while recovering from surgery on his finger but he's now on pace to return to game action in Week 6. Per Jamison Hensley of ESPN.com, coach Jesse Minter said Wednesday that he doesn't believe Hendrickson will be limited by the wrap he plans to wear during Sunday's game against the Browns.",
   "details": null
  },
  {
   "id": "642379",
   "name": "Justice Hill",
   "pos": "RB",
   "status": "Active",
   "date": "2026-10-14T02:01Z",
   "shortComment": "Hill turned four carries into 73 yards and caught two of four targets for five yards during the Ravens' 30-23 overtime win over the Falcons on Sunday.",
   "longComment": "Hill was responsible for each of the Ravens' two longest offensive plays of the game. He turned his first carry into 21 yards early in the first quarter before breaking away for a 47-yard scamper midway through the third, which led to an 18-yard touchdown pass from Tyler Huntley to Derrick Henry two plays later. Hill's 73 rushing yards were his most in a game since Week 4 against Kansas City (76), although he's firmly entrenched as the Ravens' change-of-pace RB2 behind Henry. The Ravens will stay on the road for Week 6 against the Browns on Oct. 18.",
   "details": null
  },
  {
   "id": "-2037990",
   "name": "Aeneas Peebles",
   "pos": "DT",
   "status": "Active",
   "date": "2026-10-12T18:57Z",
   "shortComment": "",
   "longComment": "",
   "details": null
  },
  {
   "id": "642195",
   "name": "Tyler Loop",
   "pos": "PK",
   "status": "Active",
   "date": "2026-10-12T17:20Z",
   "shortComment": "Loop went 3-for-3 on field-goal attempts and made his lone extra-point try during the Ravens' 30-23 overtime win over the Falcons on Sunday.",
   "longComment": "All three of Loop's made field goals came in the first half, the last two of which both came from 51 yards. It was his first game of the season of at least three field goals, and his five makes from 50-plus yards are tied for second-most in the NFL behind Spencer Shrader (six). Loop is 9-for-11 on field-goal attempts and 15-for-15 on PATs through five regular-season games, and the Ravens will hit the road for a Week 6 AFC North clash against the Browns on Oct. 18.",
   "details": null
  },
  {
   "id": "642148",
   "name": "Mark Andrews",
   "pos": "TE",
   "status": "Active",
   "date": "2026-10-12T04:51Z",
   "shortComment": "Andrews caught four of six targets for 28 yards and lost a fumble in Sunday's 30-23 overtime win over the Falcons.",
   "longComment": "Andrews finished third on the team in catches and receiving yards behind wide receivers Zay Flowers and Rashod Bateman, but the veteran tight end had a forgettable night full of miscues. Atlanta's first touchdown came on a 36-yard Jessie Bates return of Andrews' first-quarter fumble, and Andrews also failed to come down with a pair of catchable balls in the end zone, one of which would have resulted in a touchdown, while the other was an attempted two-point conversion. Andrews' ceiling would rise if the Ravens get starting QB Lamar Jackson (ankle) back in Week 6 at Cleveland, but Sunday night's quiet performance was due primarily to Andrews' own miscues rather than any shortcomings on the part of backup QB Tyler Huntley.",
   "details": null
  }

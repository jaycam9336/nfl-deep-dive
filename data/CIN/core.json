  {
   "id": "641152",
   "name": "Demetrius Knight Jr.",
   "pos": "LB",
   "status": "Active",
   "date": "2026-10-07T02:23Z",
   "shortComment": "Knight finished Sunday's 22-17 loss to the Jaguars with six tackles (three solo).",
   "longComment": "Linebacker Barrett Carter led the Bengals with 11 total tackles Sunday, with Knight finishing as the team's runner-up in that category. Knight's 45 defensive snaps (73.8 percent) were his fewest of the season after the second-year pro played at least 89.5 percent of the Bengals' defensive snaps in each of his first three games. He's up to 34 tackles (14 solo) and a scoop-and-score on the year.",
   "details": null
  },
  {
   "id": "641025",
   "name": "Mitchell Tinsley",
   "pos": "WR",
   "status": "Active",
   "date": "2026-10-06T02:52Z",
   "shortComment": "Tinsley caught three of his seven targets for 49 yards in the Bengals' 22-17 loss to the Jaguars on Sunday.",
   "longComment": "Tinsley's seven targets were fourth most among Bengals pass catchers behind Tee Higgins' (groin) 16, Chase Brown's 11 and Dohnte Meyers' nine. Tinsley stepped up after Ja'Marr Chase exited the contest with a concussion. Tinsley signed with the active roster Sept. 29 and likely will remain on it while the team deals with extensive injuries to the wide receiver corps.",
   "details": null
  },

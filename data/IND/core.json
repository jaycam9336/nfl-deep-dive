  {
   "id": "641431",
   "name": "Akeem Davis-Gaither",
   "pos": "LB",
   "status": "Active",
   "date": "2026-10-08T23:25Z",
   "shortComment": "Davis-Gaither (knee) was a full participant at practice Thursday.",
   "longComment": "Davis-Gaither popped up on the Colts' injury report with a knee issue Wednesday, but it doesn't look like it was anything too serious, and he's back on track to suit up in Week 5. He projects as a solid IDP option in most formats going into Sunday's contest against the Steelers.",
   "details": null
  },
  {
   "id": "641154",
   "name": "Justin Walley",
   "pos": "CB",
   "status": "Active",
   "date": "2026-10-07T02:34Z",
   "shortComment": "Walley recorded eight tackles (five solo), including 1.0 sacks, during the Colts' 30-13 win over the Commanders on Sunday in London.",
   "longComment": "Walley briefly left Sunday's game early in the third quarter due to an undisclosed injury but was back on the field for the Colts' next defensive drive, and he sacked QB Athan Kaliakmanis for a nine-yard loss later in the same period. It was the first sack of Walley's NFC career, and he has 22 tackles (15 solo) and three pass defenses through four regular-season games.",
   "details": null
  },
  {
   "id": "641016",
   "name": "Seth McGowan",
   "pos": "RB",
   "status": "Active",
   "date": "2026-10-06T02:36Z",
   "shortComment": "McGowan turned six carries into 31 yards and caught one of two targets for seven yards during Sunday's 30-13 win over the Commanders in London. He also returned four kickoffs for 102 yards.",
   "longComment": "McGowan actually saw most of his offensive output in the second quarter with four carries for 18 yards and his seven-yard catch. Most of his on-field production figures to come on special teams as a returner, but the rookie seventh-rounder would be poised for RB1 duties if Jonathan Taylor misses time. The Colts will hit the road for Week 5 against the Steelers this Sunday.",
   "details": null
  }

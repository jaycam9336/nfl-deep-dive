  {
   "id": "642074",
   "name": "Jacob Parrish",
   "pos": "CB",
   "status": "Active",
   "date": "2026-10-12T00:15Z",
   "shortComment": "Parrish recorded nine total tackles (eight solo) and four passes defensed during Thursday night's 24-16 win over the Cowboys.",
   "longComment": "Parrish led the team in takedowns in the victory, notching at least five tackles for the third game in a row. The cornerback has now compiled 21 total tackles (19 solo) and seven passes defensed, including an interception, over four contests this season.",
   "details": null
  },
  {
   "id": "642069",
   "name": "Alex Anzalone",
   "pos": "LB",
   "status": "Active",
   "date": "2026-10-12T00:02Z",
   "shortComment": "Anzalone recorded five total tackles (one solo) and an interception during Thursday night's 24-16 win over Dallas.",
   "longComment": "Anzalone was able to secure at least five takedowns for the fourth time in five contests this year, but his biggest play of the game came in the fourth quarter. The linebacker was able to reel in a deflected pass from Cowboys quarterback Dak Prescott with 1:22 left in regulation, notching his first interception as a member of the Buccaneers. On the season, Anzalone has compiled 27 total tackles (nine solo), including 1.0 sacks, while also intercepting a pass over five contests.",
   "details": null
  },
  {
   "id": "641743",
   "name": "Ted Hurst III",
   "pos": "WR",
   "status": "Active",
   "date": "2026-10-10T17:27Z",
   "shortComment": "Hurst did not record a target during the Buccaneers' 24-16 win over the Cowboys on Thursday.",
   "longComment": "Hurst saw at least three targets in each of the first four games of the regular season, but he did not see a pass from Jalon Daniels during Thursday's game, and the former's 33 offensive snaps were a distant third among Bucs wideouts behind Emeka Egbuka (64) and Chris Godwin (63). Hurst will take an 8-128-1 receiving line (16 targets) into Tampa Bay's Week 6 home game against Pittsburgh, and for now, it looks like Daniels will remain as the starter while Baker Mayfield (thumb) continues to recover from his injury.",
   "details": null
  },
  {
   "id": "641733",
   "name": "Tez Johnson",
   "pos": "WR",
   "status": "Active",
   "date": "2026-10-10T04:43Z",
   "shortComment": "Johnson caught his lone target for 64 yards during Thursday's 24-16 win over the Cowboys.",
   "longComment": "Johnson took advantage of the Cowboys' lapse in the secondary, with the second-year wideout on the receiving end of a deep ball from Jalon Daniels that the former turned into a 64-yard catch that led to a one-yard touchdown run by Bucky Irving three plays later. It was Johnson's second catch of 40-plus yards this season and third since entering the league in 2025 as a seventh-round draft pick. It's hard to rely on consistent production from the Bucs' pass catchers while Daniels is under center instead of Baker Mayfield (thumb), though Johnson is capable of having occasional big plays.",
   "details": null
  },
  {
   "id": "641499",
   "name": "Chase McLaughlin",
   "pos": "PK",
   "status": "Active",
   "date": "2026-10-09T04:25Z",
   "shortComment": "McLaughlin made his only field-goal attempt and all three extra-point tries Thursday in a 24-16 win against Dallas.",
   "longComment": "McLaughlin made all three of his PAT tries before nailing a 41-yard field goal late in the third quarter. He could have had an additional chip-shot FG midway through the fourth, but the Buccaneers somewhat surprisingly tried (and failed) to get into the end zone on a fourth-and-goal play from the 1-yard line when a field goal would have given them a three-score lead. Regardless, McLaughlin looked fine after missing practice Tuesday with a right groin/hip issue, and he's now a perfect 10-for-10 on field-goal attempts this season.",
   "details": null
  },
  {
   "id": "641266",
   "name": "Ko Kieft",
   "pos": "TE",
   "status": "Active",
   "date": "2026-10-07T22:50Z",
   "shortComment": "Kieft (elbow) does not carry an injury designation into Thursday's game against the Cowboys, Brianna Dix of the Buccaneers' official site reports.",
   "longComment": "Kieft managed to fade an injury designation after practicing in full Wednesday, and the fifth-year pro has been cleared to return from a one-game absence due to an elbow injury. He's mostly contributed on special teams this season, but he will also provide depth at the tight end position behind Cade Otton and Payne Durham.",
   "details": null
  }
 ],

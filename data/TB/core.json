 "injuries": [
  {
   "id": "643241",
   "name": "Cade Otton",
   "pos": "TE",
   "status": "Active",
   "date": "2026-10-19T03:31Z",
   "shortComment": "Otton caught one of two targets for four yards in Sunday's 26-19 overtime loss to the Steelers.",
   "longComment": "Otton ws targeted on just two of Jalon Daniels' 43 pass attempts, good for a lousy 4.7 percent share. The tight end has yet to catch a touchdown this season and has been held below 40 yards in five of six contests. He's a low-floor fantasy option at the position who is best left on waivers.",
   "details": null
  },
  {
   "id": "643233",
   "name": "Chris Godwin Jr.",
   "pos": "WR",
   "status": "Active",
   "date": "2026-10-19T02:49Z",
   "shortComment": "Godwin caught four of eight targets for 37 yards in Sunday's 26-19 overtime loss to the Steelers.",
   "longComment": "For the fifth time in six games to begin the season, Godwin caught either three or four passes, and all six of his yardage totals have been between 25 and 46 yards. The veteran wideout also has yet to score a TD in 2026, and his lackluster production has come whether Baker Mayfield (thumb) or rookie Jalon Daniels has been under center. Godwin will try to find a way to break out in Week 7 against the Panthers.",
   "details": null
  },
  {
   "id": "643230",
   "name": "Emeka Egbuka",
   "pos": "WR",
   "status": "Active",
   "date": "2026-10-19T02:43Z",
   "shortComment": "Egbuka caught seven of 16 targets for 48 yards and a touchdown in Sunday's 26-19 overtime loss to the Steelers.",
   "longComment": "It was the first time this season that Egbuka got double-digit targets, but the volume didn't turn into a whole lot of production aside from a two-yard TD in the second quarter. Egbuka still set a new season high in receptions, and he remains the first look for rookie quarterback Jalon Daniels while he fills in for Baker Mayfield (thumb). Egbuka will take a 28-240-2 line on 49 targets into a Week 7 clash with the Panthers.",
   "details": null
  },
  {
   "id": "643229",
   "name": "Bucky Irving",
   "pos": "RB",
   "status": "Active",
   "date": "2026-10-19T02:38Z",
   "shortComment": "Irving carried the ball 19 times for 46 yards and caught two of three targets for three yards in Sunday's 26-19 overtime loss to the Steelers.",
   "longComment": "It's the first time this season Irving's failed to reach 50 scrimmage yards in a game, and his longest gain went for just 13 yards. The third-year back remains the top option in the Tampa Bay backfield, however, as Kenny Gainwell saw only three touches in Sunday's loss. Irving will look to bounce back in Week 7 against the Panthers.",
   "details": null
  },
  {
   "id": "643227",
   "name": "Jalon Daniels",
   "pos": "QB",
   "status": "Active",
   "date": "2026-10-19T02:33Z",
   "shortComment": "Daniels completed 22 of 43 passes for 164 yards and one touchdown with two interceptions in Sunday's 26-19 overtime loss to the Steelers. He added 39 rushing yards on four carries.",
   "longComment": "The rookie quarterback struggled in his third career start, but Daniels did connect with Emeka Egbuka on a two-yard score in the second quarter and had Tampa Bay in front 16-3 to begin the fourth. Once Aaron Rodgers began putting points on the board, though, Daniels buckled under the pressure and threw both his INTs. Baker Mayfield (thumb) has yet to return to practice, giving Daniels good odds of making his fourth straight start in Week 7 against the Panthers, but his 3:5 TD:INT since the veteran QB went down doesn't make him a very appealing fantasy option.",
   "details": null
  },
  {
   "id": "643218",
   "name": "Kenny Gainwell",
   "pos": "RB",
   "status": "Active",
   "date": "2026-10-19T02:06Z",
   "shortComment": "Gainwell rushed two times for 17 yards in Sunday's 26-19 overtime loss to the Steelers. He caught his only target for seven yards.",
   "longComment": "Even with Sean Tucker (quadriceps) inactive, Gainwell didn't see any sort of increase in his offensive role, getting out-carried 19 to two by Bucky Irving, who also saw three targets. Gainwell has 122 total yards through six games and can be sent to waivers in 10- and 12-team redraft fantasy leagues.",
   "details": null
  },
  {
   "id": "643049",
   "name": "Josiah Trotter",
   "pos": "LB",
   "status": "Active",
   "date": "2026-10-18T16:28Z",
   "shortComment": "Trotter (knee) is active against the Steelers on Sunday.",
   "longComment": "Trotter popped up on Friday's injury report as a limited participant due to a knee injury, but the rookie second-rounder has been cleared to play Sunday after going through pregame warmups. He has 40 tackles (22 solo), including 1.0 sacks, and a pick-six through four regular-season games.",
   "details": null
  },
  {
   "id": "643046",
   "name": "SirVocea Dennis",
   "pos": "LB",
   "status": "Active",
   "date": "2026-10-18T16:25Z",
   "shortComment": "Dennis (ankle/foot) is active for Sunday's game against the Steelers.",
   "longComment": "Ankle and foot injuries prevented Dennis from playing against the Cowboys in Week 5. He drew the questionable tag for Week 6 after logging a full practice Friday, and the fourth-year linebacker has been given the green light to return for Sunday's contest.",
   "details": null
  },
  {
   "id": "643042",
   "name": "Sean Tucker",
   "pos": "RB",
   "status": "Out",
   "date": "2026-10-18T16:21Z",
   "shortComment": "Tucker (quadriceps) is inactive for Sunday's game against the Steelers.",
   "longComment": "Tucker ended Week 6 prep with consecutive limited sessions as he manages a quadriceps injury. The running back is not quite ready to return to the field and will not suit up for Sunday's game. Josh Williams has been elevated from the practice squad to serve as the Buccaneers' No. 3 running back behind Bucky Irving and Kenny Gainwell on Sunday.",

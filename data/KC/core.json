  {
   "id": "642946",
   "name": "Justin Watson",
   "pos": "WR",
   "status": "Active",
   "date": "2026-10-18T02:11Z",
   "shortComment": "The Chiefs elevated Watson from the practice squad Saturday ahead of Sunday's game against the Chargers, Matt Derrick of ChiefsDigest.com reports.",
   "longComment": "Watson signed with Kansas City earlier this week and will provide the team with experience at wide receiver after Rashee Rice (hamstring) was ruled out for Week 6. Tyquan Thornton (ankle) was also lost to injured reserve two weeks ago.",
   "details": null
  },
  {
   "id": "642945",
   "name": "Andrew Armstrong",
   "pos": "WR",
   "status": "Active",
   "date": "2026-10-18T02:09Z",
   "shortComment": "The Chiefs have elevated Armstrong from the practice squad ahead of Sunday's game against the Chargers, Matt Derrick of ChiefsDigest.com reports.",
   "longComment": "With Rashee Rice (hamstring) out and Tyquan Thornton (ankle) on injured reserve, Armstrong and Justin Watson were both elevated from the practice squad Saturday. The Chiefs are extremely thin on experienced wide receivers headed into Week 6. Armstrong has never appeared in a regular-season NFL game.",
   "details": null
  },
  {
   "id": "-2043731",
   "name": "Peter Woods",
   "pos": "DT",
   "status": "Active",
   "date": "2026-10-16T20:48Z",

   "details": null
  },
  {
   "id": "642310",
   "name": "Tyquan Thornton",
   "pos": "WR",
   "status": "Injured Reserve",
   "date": "2026-10-13T18:29Z",
   "shortComment": "The Chiefs placed Thornton (ankle) on injured reserve Tuesday.",
   "longComment": "The transaction frees up a spot on the 53-man roster for linebacker Cam Jones, who was signed off the practice squad. After dislocating his left ankle in the Chiefs' Oct. 4 win over the Raiders and requiring surgery, Thornton is facing an estimated recovery timeline of 3-to-4 months, which means that he'll likely be sidelined until at least Week 17 or 18 in a best-case scenario. While Thornton is out, the Chiefs are expected to lean on Jalen Royals and Cyrus Allen to handle more reps in three-receiver sets alongside starters Rashee Rice (hamstring) and Xavier Worthy.",
   "details": {
    "fantasyStatus": {
     "description": "IR",
     "abbreviation": "IR"
    },
    "type": "Ankle",
    "location": "Leg",
    "detail": "Surgery",
    "side": "Left",
    "returnDate": "2027-01-17"
   }
  },
  {
   "id": "641138",
   "name": "Nick Bolton",
   "pos": "LB",
   "status": "Active",
   "date": "2026-10-07T01:36Z",
   "shortComment": "Bolton posted nine tackles (four solo) during the Chiefs' 30-27 win over the Raiders on Sunday.",
   "longComment": "Bolton played every single defensive snap during Sunday's win and finished as the Chiefs' second-leading tackler behind rookie corner Mansoor Delane (10). Through four regular-season games and heading into the Chiefs' Week 5 bye, Bolton leads the team with 37 combined tackles, which is tied with Akeem Davis-Gaither and Jihaad Campbell for sixth-most in the NFL.",
   "details": null
  },
  {
   "id": "641132",
   "name": "Mansoor Delane",
   "pos": "CB",
   "status": "Active",
   "date": "2026-10-07T01:23Z",
   "shortComment": "Delane tallied 10 tackles (seven solo) and one pass defense during the Chiefs' 30-27 win over the Raiders on Sunday.",
   "longComment": "The rookie first-rounder played 78 of 84 defensive snaps Sunday (92.9 percent) and was the only Chiefs player to log double-digit tackles. He's reached that mark in back-to-back games and is up to 20 tackles (14 solo) and three pass defenses (including one interception) through the first three games of his NFL career. Up next for the Chiefs is a Week 6 home game Sunday, Oct. 18 against the Chargers, whose offense has struggled with Justin Herbert under center.",
   "details": null
  },
  {
   "id": "641017",
   "name": "Cyrus Allen",
   "pos": "WR",
   "status": "Active",
   "date": "2026-10-06T02:37Z",
   "shortComment": "Allen failed to reel in his only target in Sunday's 30-27 win over the Raiders.",
   "longComment": "Allen went without a reception for the fourth straight contest to open his NFL career. The wide receiver impressed during the preseason, but he has yet to make his mark during the regular season. Allen could be set for an expanded role following the team's Week 5 bye week, though, as both Rashee Rice (hamstring) and Tyquan Thornton (ankle) suffered injuries against Las Vegas, the latter of which is season-ending.",
   "details": null
  },
  {
   "id": "641013",
   "name": "Noah Gray",
   "pos": "TE",
   "status": "Active",
   "date": "2026-10-06T02:30Z",
   "shortComment": "Gray caught two of his three targets for 17 yards in the Chiefs' 30-27 win over the Raiders on Sunday.",
   "longComment": "Gray was utilized at a similar rate to No. 1 TE Travis Kelce in the contest. The tight end once again contributed to blocking for Kenneth Walker in 12-personnel packages but has not logged a lot of attention in the Chiefs' passing offense this season.",
   "details": null
  },
  {
   "id": "640978",
   "name": "Emmett Johnson",
   "pos": "RB",
   "status": "Active",
   "date": "2026-10-06T01:10Z",
   "shortComment": "Johnson caught his lone target for 10 yards in Sunday's 30-27 win over the Raiders.",
   "longComment": "The rookie running back didn't handle a single rushing attempt behind Kenneth Walker's 22 carries for 177 yards and two touchdowns. Johnson still played 17 offensive snaps and remains the clear backup and bench stash to own in fantasy should something ever happen to Walker.",
   "details": null
  },
  {
   "id": "640838",
   "name": "Harrison Butker",
   "pos": "PK",
   "status": "Active",
   "date": "2026-10-05T03:50Z",
   "shortComment": "Butker converted his only field-goal attempt and all three of his PATs during Sunday's 30-27 win over the Raiders.",
   "longComment": "Butker made a 28-yard field-goal try in the second quarter, but he was limited to just one field-goal make for the third time over four contests this season. The kicker has gone 7-for-9 on field-goal attempts, including 0-for-2 from 50-plus yards, to this point in the 2026 campaign.",
   "details": null
  },
  {
   "id": "640047",
   "name": "Chamarri Conner",
   "pos": "S",
   "status": "Active",
   "date": "2026-09-30T23:24Z",
   "shortComment": "Conner (knee) was a full participant at practice Wednesday.",
   "longComment": "Conner has still yet to make his regular-season debut in 2026 due to a knee injury he suffered before the campaign started, but it now looks like he's on track to do so in Week 4. He projects to start at safety next to free-agent acquisition Alohi Gilman on Sunday at Las Vegas.",
   "details": null
  },
